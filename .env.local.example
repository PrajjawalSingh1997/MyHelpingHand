# Supabase — get these from your Supabase project dashboard
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — required only for the Admin Panel (/admin).
# Project Settings > API > service_role (secret). Server-side only,
# never exposed to the browser. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
